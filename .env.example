# --- Supabase ---------------------------------------------------------------
# Project settings → API. The anon/publishable key is safe for the browser.
# The service role key is server-only — NEVER expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin access -------------------------------------------------------------
# Only this email is allowed to sign in to /admin (enforced in middleware + RLS).
ADMIN_EMAIL=admin@example.com

# --- AI chatbot (Vercel AI SDK, provider-agnostic) -----------------------------
# AI_PROVIDER selects the adapter in lib/ai/provider.ts, e.g. "openai" | "anthropic".
# AI_MODEL is the model id for that provider, e.g. "gpt-4o-mini" | "claude-haiku-4-5".
# AI_API_KEY is the provider's API key.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- Booking ------------------------------------------------------------------
# Your Cal.com event link, e.g. "https://cal.com/your-team/intro-call".
CAL_LINK=https://cal.com/your-team/intro-call

# --- WhatsApp -------------------------------------------------------------------
# International format, no spaces, no leading zero, no plus sign (wa.me format).
WHATSAPP_NUMBER=971589342572

# --- Site -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
